    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "tailwind-merge": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8",
    "prettier": "^3.9.3",
