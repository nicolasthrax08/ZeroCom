# ZeroCom Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

NODE_ENV=development

# --- Docker Compose (required for docker compose up) ---
POSTGRES_USER=zerocom
POSTGRES_PASSWORD="REPLACE-WITH-STRONG-PASSWORD"
POSTGRES_DB=zerocom

# --- Next.js app ---
# PostgreSQL connection string (required for production)
DATABASE_URL="postgresql://zerocom:REPLACE-WITH-STRONG-PASSWORD@localhost:5432/zerocom?schema=public"

# Authentication secrets — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE-WITH-RANDOM-32-BYTE-SECRET"
PHONE_HMAC_SECRET="REPLACE-WITH-RANDOM-32-BYTE-SECRET"

# AES-256-GCM encryption key for PII (base64-encoded 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="REPLACE-WITH-RANDOM-32-BYTE-KEY"

# Salt for hashing ID card numbers and real names (PII)
ID_HASH_SALT="REPLACE-WITH-RANDOM-SALT"

# Provider adapters (set to "mock" for local dev)
SMS_PROVIDER=mock
OCR_PROVIDER=mock
GEOCODER_PROVIDER=mock

# Payment provider mock flags (set to "false" in production when real adapters are wired)
ALIPAY_MOCK=true
WECHATPAY_MOCK=true

# Mock payment webhook secret (required even in mock mode)
PAYMENT_MOCK_SECRET="REPLACE-WITH-RANDOM-SECRET"
